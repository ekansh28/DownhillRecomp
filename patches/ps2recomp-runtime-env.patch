@@ -316,8 +316,12 @@ namespace ps2_stubs
         if (ok)
         {
             g_cdStreamingLbn = selected.lbn + selected.sectors;
-            setReturnS32(ctx, 1); // command accepted/success
-            return;
+            // A real read takes time: block the caller until the next frame so lower-priority
+            // threads (e.g. a worker the game just started) run, then return 1 (accepted).
+            // Resume at the caller: generated wrappers set pc = ra, but a stub bound by address
+            // (replaceFunction) is entered with pc = its own address.
+            ctx->pc = getRegU32(ctx, 31);
+            runtime->eeScheduler().waitVSync(runtime->eeScheduler().currentVSyncTick(), 1);
         }
 
         setReturnS32(ctx, 0);
diff --git i/ps2xRuntime/src/lib/Kernel/Syscalls/Common.h w/ps2xRuntime/src/lib/Kernel/Syscalls/Common.h
index c0b13bf..ddcc2e4 100644
--- i/ps2xRuntime/src/lib/Kernel/Syscalls/Common.h
+++ w/ps2xRuntime/src/lib/Kernel/Syscalls/Common.h
@@ -22,6 +22,7 @@
 #include <ctime>
 #include <memory>
 #include <string>
+#include <string_view>
 
 #ifndef _WIN32
 #include <unistd.h>
@@ -84,3 +85,20 @@ inline T *getEeGuestStruct(uint8_t *rdram, uint32_t address)
 {
     return const_cast<T *>(getEeGuestStruct<T>(static_cast<const uint8_t *>(rdram), address));
 }
+
+// PS2X_TRACE_SYSCALLS=1: prints the first calls of thread/semaphore/interrupt syscalls (debug aid).
+inline void traceSyscall(const char *name, const R5900Context *ctx)
+{
+    static const bool enabled = std::getenv("PS2X_TRACE_SYSCALLS") != nullptr;
+    static std::atomic<int> printed{0};
+    if (!enabled)
+        return;
+    const std::string_view n(name);
+    if (n == "FlushCache" || n == "iFlushCache" || n == "EnableDmac" || n == "DisableDmac" || n == "GetThreadId")
+        return;
+    if (printed.fetch_add(1) >= 3000)
+        return;
+    std::fprintf(stderr, "[syscall] %s a0=%x a1=%x a2=%x a3=%x ra=%x\n", name, getRegU32(const_cast<R5900Context *>(ctx), 4),
+                 getRegU32(const_cast<R5900Context *>(ctx), 5), getRegU32(const_cast<R5900Context *>(ctx), 6),
+                 getRegU32(const_cast<R5900Context *>(ctx), 7), getRegU32(const_cast<R5900Context *>(ctx), 31));
+}
