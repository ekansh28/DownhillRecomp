+            std::string line;
+            while (std::getline(in, line))
+            {
+                line = line.substr(0, line.find('#'));
+                line.erase(std::remove_if(line.begin(), line.end(), [](unsigned char c) { return std::isspace(c); }), line.end());
+                const size_t at = line.rfind('@');
+                if (at == std::string::npos)
+                {
+                    continue;
+                }
